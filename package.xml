<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lio</name>
  <version>0.1.0</version>
  <description>LiDAR-inertial odometry for continuous localization through elevator motion.</description>
  <maintainer email="xiaofan0100@sjtu.edu.cn">Yifan Zhang</maintainer>
  <license>GPL-2.0-or-later</license>

  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <depend>yaml-cpp</depend>
  <depend>tbb</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>gtsam</depend>
  <build_depend>qtbase5-dev</build_depend>

  <buildtool_depend condition="$ROS_VERSION == 1 or $ROS_VERSION == 'ROS1'">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2 or $ROS_VERSION == 'ROS2'">ament_cmake</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2 or $ROS_VERSION == 'ROS2'">rosidl_default_generators</buildtool_depend>

  <depend condition="$ROS_VERSION == 1 or $ROS_VERSION == 'ROS1'">roscpp</depend>
  <depend condition="$ROS_VERSION == 1 or $ROS_VERSION == 'ROS1'">roslib</depend>
  <exec_depend condition="$ROS_VERSION == 1 or $ROS_VERSION == 'ROS1'">rospy</exec_depend>
  <depend condition="$ROS_VERSION == 2 or $ROS_VERSION == 'ROS2'">rclcpp</depend>
  <depend condition="$ROS_VERSION == 2 or $ROS_VERSION == 'ROS2'">ament_index_cpp</depend>
  <depend condition="$ROS_VERSION == 2 or $ROS_VERSION == 'ROS2'">livox_ros_driver2</depend>
  <build_depend>geometry_msgs</build_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <build_depend>nav_msgs</build_depend>
  <exec_depend>nav_msgs</exec_depend>
  <build_depend>sensor_msgs</build_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <build_depend>std_msgs</build_depend>
  <exec_depend>std_msgs</exec_depend>
  <build_depend>pcl_ros</build_depend>
  <exec_depend>pcl_ros</exec_depend>
  <build_depend>pcl_conversions</build_depend>
  <exec_depend>pcl_conversions</exec_depend>
  <build_depend>tf2_ros</build_depend>
  <exec_depend>tf2_ros</exec_depend>

  <depend>std_srvs</depend>
  <depend condition="$ROS_VERSION == 1 or $ROS_VERSION == 'ROS1'">rviz</depend>
  <depend condition="$ROS_VERSION == 2 or $ROS_VERSION == 'ROS2'">rviz_common</depend>
  <exec_depend condition="$ROS_VERSION == 2 or $ROS_VERSION == 'ROS2'">rviz2</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2 or $ROS_VERSION == 'ROS2'">launch</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2 or $ROS_VERSION == 'ROS2'">launch_ros</exec_depend>
  <depend>pluginlib</depend>

  <build_depend condition="$ROS_VERSION == 1 or $ROS_VERSION == 'ROS1'">message_generation</build_depend>
  <exec_depend condition="$ROS_VERSION == 1 or $ROS_VERSION == 'ROS1'">message_runtime</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2 or $ROS_VERSION == 'ROS2'">rosidl_default_runtime</exec_depend>
  <member_of_group condition="$ROS_VERSION == 2 or $ROS_VERSION == 'ROS2'">rosidl_interface_packages</member_of_group>

  <export>
    <build_type condition="$ROS_VERSION == 1 or $ROS_VERSION == 'ROS1'">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2 or $ROS_VERSION == 'ROS2'">ament_cmake</build_type>
    <rviz condition="$ROS_VERSION == 1 or $ROS_VERSION == 'ROS1'" plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
